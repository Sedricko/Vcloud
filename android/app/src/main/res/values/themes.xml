<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Vcloud: segue o tema do sistema (claro/escuro); as cores vêm de values/colors.xml e values-night/colors.xml -->
    <style name="Theme.Vcloud" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>

        <item name="colorSecondary">@color/primary_light</item>
        <item name="colorSecondaryVariant">@color/primary</item>
        <item name="colorOnSecondary">@color/on_primary</item>

        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="colorOnBackground">@color/on_surface</item>
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColorSecondary">@color/secondary_text</item>

        <!-- o app desenha por baixo das barras (BaseActivity trata as bordas): barras transparentes, ícones pelo tema -->
        <item name="android:statusBarColor" tools:targetApi="l">@android:color/transparent</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">@bool/tema_claro</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/tema_claro</item>

        <item name="actionMenuTextColor">@color/on_surface</item>

        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="ToolBarColorStyle" parent="ThemeOverlay.MaterialComponents.ActionBar">
        <item name="actionMenuTextColor">@color/on_surface</item>
        <item name="colorControlNormal">@color/on_surface</item>

        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="WelcomeTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/splash</item>
    </style>

    <!-- Vcloud: janela "Permitir root?" (activity translúcida só com o diálogo) -->
    <style name="Theme.Vcloud.Prompt" parent="Theme.Vcloud">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
